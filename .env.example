# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API Keys / Data API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Único e-mail Google autorizado a entrar no app
ALLOWED_EMAIL=voce@gmail.com

# --- Sincronização com o LibreLinkUp (cadastre na Vercel como "Sensitive") ---
# Supabase > Project Settings > API Keys > Secret keys
SUPABASE_SECRET_KEY=sb_secret_xxx
LIBRE_LINK_UP_EMAIL=email-da-conta-librelinkup@exemplo.com
LIBRE_LINK_UP_PASSWORD=senha-da-conta-librelinkup
# Segredo que o pg_cron envia para /api/sync (o mesmo valor fica no Vault do Supabase)
SYNC_SECRET=gere-um-valor-aleatorio
# Opcional: versão do app informada ao LibreLinkUp (padrão 4.16.0)
# LIBRE_LINK_UP_VERSION=4.16.0
